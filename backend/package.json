{
  "name": "lotofacil-backend",
  "version": "1.0.0",
  "description": "Lotofácil Gravity Analysis – Express + MongoDB API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/backend/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "seed": "tsx services/seeder.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "mongoose": "^8.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
